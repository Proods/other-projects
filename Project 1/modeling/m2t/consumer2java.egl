package eng2.[%=microservice.name.replace("-microservice","").replace("-",".")%]s.events;

import io.micronaut.configuration.kafka.annotation.KafkaKey;
import io.micronaut.configuration.kafka.annotation.KafkaListener;
import io.micronaut.configuration.kafka.annotation.Topic;


@KafkaListener(groupId="[%=consumer.groupId%]")
public class [%=consumer.name%] {
	
	[%for (attr in consumer.attributes) {%]
	[%=attr.dataType.name%] [%=attr.name%];

	[%}%]

	[%for (event in consumer.events) {%]
	@Topic("[%=event.topic.name%]")
	public void [%=event.name%](@KafkaKey [%=event.key.dataType.name%] [%=event.key.name%], [%=event.value.dataType.name%] [%=event.value.name%]) {

	}

	[%}%]
	[%for (method in consumer.methods) {%]
	private [%=method.dataType.name%] [%=method.name%]([%var temp = "" ;
	for (param in method.paramters) {
		temp = temp + param.dataType.name + " " + param.name + ", ";
	}
	if (method.paramters.notEmpty()) {
		temp = temp.substring(0,temp.length()-2);
	}%][%=temp%]) {

	}

	[%}%]
}
